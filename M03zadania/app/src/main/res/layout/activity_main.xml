<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShopApp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnChleb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dodaj chleb" />

    <Button
        android:id="@+id/btnMleko"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dodaj mleko" />

    <Button
        android:id="@+id/btnMaslo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dodaj masło" />

    <TextView
        android:id="@+id/txtOstatnioDodano"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ostatnio dodano: nic"
        android:textSize="20sp"
        android:layout_marginTop="30dp" />

</LinearLayout>
